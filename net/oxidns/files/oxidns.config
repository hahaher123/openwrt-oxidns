config settings 'main'
	option config_path '/etc/oxidns/config.yaml'
	option working_dir '/var/lib/oxidns'
	# Optional log level override passed to `oxidns start -l`
	# (off, trace, debug, info, warn, error). Empty means: use the config file.
	option log_level ''
	# Run `oxidns check` before starting and refuse to start on a broken config.
	option probe_config '1'
