#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
#
# PROCD init script for OxiDNS.
#
# Shipped by the "oxidns-service" package of openwrt-oxidns. luci-app-oxidns
# ships its own copy of this file; install one or the other, never both.
#
# Paths are the ones luci-app-oxidns and the official release archives use:
#   binary  : /usr/bin/oxidns
#   config  : /etc/oxidns/config.yaml
#   workdir : /var/lib/oxidns

START=90
STOP=10

USE_PROCD=1

PROG="/usr/bin/oxidns"
DEFAULT_CONFIG_PATH="/etc/oxidns/config.yaml"
DEFAULT_WORKING_DIR="/var/lib/oxidns"

start_service() {
	local config_path working_dir log_level probe_config

	config_load oxidns
	config_get config_path main config_path "$DEFAULT_CONFIG_PATH"
	config_get working_dir main working_dir "$DEFAULT_WORKING_DIR"
	config_get log_level main log_level ""
	config_get_bool probe_config main probe_config 1

	if [ ! -x "$PROG" ]; then
		echo "oxidns: binary not found or not executable: $PROG" >&2
		return 1
	fi

	if [ ! -r "$config_path" ]; then
		echo "oxidns: configuration not found: $config_path" >&2
		return 1
	fi

	mkdir -p "$working_dir"

	# Fail fast on a broken config instead of respawning in a crash loop.
	if [ "$probe_config" = "1" ]; then
		if ! "$PROG" check -c "$config_path" -d "$working_dir" >/dev/null 2>&1; then
			echo "oxidns: configuration check failed: $config_path" >&2
			"$PROG" check -c "$config_path" -d "$working_dir" >&2 || true
			return 1
		fi
	fi

	procd_open_instance
	procd_set_param command "$PROG" start -c "$config_path" -d "$working_dir"
	if [ -n "$log_level" ]; then
		procd_append_param command -l "$log_level"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_close_instance
}

# OxiDNS does not install a SIGHUP handler, so the procd "reload" signal would
# hit the default disposition and kill the process. A restart is the only
# correct way to pick up a configuration change.
reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger oxidns
}
